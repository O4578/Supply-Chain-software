# SupplyChain Intelligence — AI Research Assistant backend

# --- AI provider (choose ONE; keys are never sent to the browser) ------------
# Any one of these enables full AI research. Without one, the app runs in
# dataset-only mode (answers built strictly from your local database).
AI_PROVIDER=            # optional: openai | anthropic | mistral (auto-detected if unset)

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Any OpenAI-compatible local server also works, e.g.:
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1   (Ollama with an OpenAI-style adapter)
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1    (LM Studio)

# --- Web search (at least one recommended; SEC EDGAR works without a key) ---
TAVILY_API_KEY=
BRAVE_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
SERPAPI_KEY=

# --- Optional ---------------------------------------------------------------
# SEC fair-access requires a descriptive contact in the User-Agent.
SEC_USER_AGENT=SupplyChain-Intelligence-Research you@example.com

PORT=3000
HOST=127.0.0.1
RATE_LIMIT_PER_MINUTE=10
